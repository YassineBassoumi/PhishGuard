@startuml UC_sprint4_1
' ==========================================================================
'  Diagramme de cas d'utilisation - Sprint 4.1 : Sécurité avancée
'  Projet : PhishGuard
'  User stories couvertes :
'    17. Authentification 2FA
'    18. Gérer les sessions actives
'    19. Supprimer mon compte
' ==========================================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor #1F4E79
skinparam ArrowThickness 1.2

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #1F4E79
    FontColor #1F4E79
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #EAF2F8
    BorderColor #1F4E79
    FontColor #1F4E79
    BorderThickness 1.2
}

skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #1F4E79
    FontColor #1F4E79
    FontStyle bold
}

skinparam note {
    BackgroundColor #FFF8E1
    BorderColor #B8860B
    FontColor #5D4E12
}

left to right direction

title <b>Diagramme de cas d'utilisation — Sprint 4.1 : Sécurité avancée</b>

' ─── Acteurs principaux (avec hiérarchie) ─────────────────────────────────
actor "Utilisateur"            as U
actor "Administrateur"         as A
actor "Super-administrateur"   as SA

A  --|> U
SA --|> A

' ─── Acteurs externes ─────────────────────────────────────────────────────
actor "Application\nd'authentification\n(TOTP)"   as TOTP
actor "Service de\nnotification email"            as MAIL

' ─── Périmètre du système ─────────────────────────────────────────────────
rectangle "PhishGuard — Sécurité avancée" {

    package "Authentification 2FA" as P_2FA {
        usecase "Activer la 2FA"                       as UC_2FA_ACT
        usecase "Désactiver la 2FA"                    as UC_2FA_DES
        usecase "Régénérer les codes\nde secours"      as UC_2FA_REG
        usecase "Saisir un code 2FA\n(à la connexion)" as UC_2FA_LOGIN
        usecase "Générer le secret\net le QR code"     as UC_2FA_QR
        usecase "Vérifier le code TOTP"                as UC_2FA_VERIF
        usecase "Générer les codes\nde secours"        as UC_2FA_BCK
    }

    package "Gestion des sessions" as P_SESS {
        usecase "Consulter les\nsessions actives" as UC_SESS_LIST
        usecase "Révoquer une session"            as UC_SESS_REV
        usecase "Révoquer toutes\nles sessions"   as UC_SESS_REVALL
    }

    package "Gestion du compte" as P_ACC {
        usecase "Supprimer mon compte"                              as UC_DEL
        usecase "Confirmer la suppression\n(\"DELETE MY ACCOUNT\")" as UC_CONF
    }

    usecase "Saisir le mot de passe\n(ré-authentification)" as UC_PWD
}

' ─── Associations Acteur ↔ Cas d'utilisation ──────────────────────────────
U -- UC_2FA_ACT
U -- UC_2FA_DES
U -- UC_2FA_REG
U -- UC_2FA_LOGIN
U -- UC_SESS_LIST
U -- UC_SESS_REV
U -- UC_SESS_REVALL
U -- UC_DEL

' Acteurs externes
TOTP -- UC_2FA_QR
TOTP -- UC_2FA_VERIF
MAIL -- UC_2FA_ACT
MAIL -- UC_2FA_DES

' ─── Relations <<include>> ────────────────────────────────────────────────
UC_2FA_ACT     ..> UC_2FA_QR    : <<include>>
UC_2FA_ACT     ..> UC_2FA_VERIF : <<include>>
UC_2FA_ACT     ..> UC_2FA_BCK   : <<include>>

UC_2FA_DES     ..> UC_PWD       : <<include>>
UC_2FA_REG     ..> UC_PWD       : <<include>>

UC_2FA_LOGIN   ..> UC_2FA_VERIF : <<include>>

UC_SESS_REV    ..> UC_SESS_LIST : <<include>>
UC_SESS_REVALL ..> UC_SESS_LIST : <<include>>

UC_DEL         ..> UC_PWD       : <<include>>
UC_DEL         ..> UC_CONF      : <<include>>

' ─── Note récapitulative ──────────────────────────────────────────────────
note bottom of P_ACC
  La suppression du compte est <b>irréversible</b> :
    • supprime l'utilisateur
    • révoque toutes les sessions
    • supprime les jetons OAuth
    • supprime l'historique d'analyses
    • supprime les journaux d'audit liés
end note

@enduml
